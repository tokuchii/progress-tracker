# Zoho Mail SMTP settings for sending OTP emails.
#
# 1. In Zoho Mail, create an app-specific password:
#    Settings > Mail Accounts > Security > App Passwords.
# 2. Set NUXT_SMTP_USER to the full @leadsagri.com address
#    and NUXT_SMTP_PASS to the app password (not your login password).
#
# Leave NUXT_SMTP_PASS empty to run in dev mode instead:
# the code is logged to the console and shown on the OTP screen.
NUXT_SMTP_HOST=smtp.zoho.com
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=no-reply@leadsagri.com
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=LeadsAgri Bootcamp <no-reply@leadsagri.com>
